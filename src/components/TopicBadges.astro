---
import { topicLabel } from '../lib/topics';
interface Props { tags: string[]; }
const { tags } = Astro.props;
---
<ul class="topic-badges" aria-label="Topics">
  {tags.map(tag => <li><a href={`/topics/${tag}/`}>{topicLabel(tag)}</a></li>)}
</ul>
<style>
  .topic-badges { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; margin:14px 0 0; }
  a { display:inline-block; padding:3px 10px; border:1px solid var(--line); border-radius:6px; background:var(--surface); color:var(--accent); font-size:13px; line-height:1.6; text-decoration:none; }
  a:hover { border-color:var(--accent); }
</style>
