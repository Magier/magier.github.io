---
import Appearance from '../components/Appearance.astro';
interface Props { title?: string; description?: string; wide?: boolean; home?: boolean; }
const { title, wide = false, home = false, description = 'A personal notebook on security, AI, systems thinking, cognition, and older ideas worth another look. By Markus Gierlinger, also known as Magier.' } = Astro.props;
const goatCounterCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE?.trim();
const analyticsEnabled = import.meta.env.PROD && !!goatCounterCode;
const fullTitle = title ? `${title} | Magier’s Musings` : 'Magier’s Musings';
---
<!doctype html>
<html lang="en" data-palette="indigo" data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/instrument-sans.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{fullTitle}</title>
    {analyticsEnabled && (
      <script is:inline defer data-goatcounter={`https://${goatCounterCode}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
    <script is:inline>
      try {
        const m = localStorage.getItem('mode');
        if (['light', 'dark'].includes(m)) document.documentElement.dataset.mode = m;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class:list={["page", { "page-wide": wide, "page-home": home }]}>
      <header class="masthead">
        <div><a href="/" class="wordmark">Magier’s Musings</a>
        </div>
        <Appearance />
      </header>
      <main id="content"><slot /></main>
      <footer>
        <p class="muted">Personal notes. Views are my own.</p>
        <a href="/privacy/">Privacy</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family:'Instrument Sans';
    font-style:normal;
    font-weight:400 700;
    font-display:swap;
    src:url('/fonts/instrument-sans.ttf') format('truetype');
  }
  :root {
    color-scheme: dark;
    --bg: #171c19; --surface: #242c26; --fg: #e3e4da;
    --accent: #9eaf88; --secondary: #c2aa7d; --muted: #a5aba1; --line: #3c463e;
    --font-text: 'Instrument Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
  }
  :root[data-palette="ember"] { --bg:#181a1b; --surface:#242728; --fg:#e7e2d8; --accent:#c97059; --secondary:#a59a83; --muted:#aaa59c; --line:#424240; }
  :root[data-palette="indigo"] { --bg:#171922; --surface:#252936; --fg:#e5e2da; --accent:#899de2; --secondary:#c18e79; --muted:#aaaab7; --line:#3d4253; }
  :root[data-mode="light"] { color-scheme:light; --bg:#f2f1e9; --surface:#e7e8df; --fg:#242c26; --accent:#50663c; --secondary:#795e30; --muted:#62695e; --line:#c9cec1; }
  :root[data-mode="light"][data-palette="ember"] { --bg:#f5f0e7; --surface:#ebe3d8; --fg:#302a27; --accent:#a24632; --secondary:#74664d; --muted:#75685d; --line:#d5c9ba; }
  :root[data-mode="light"][data-palette="indigo"] { --bg:#f7f4ed; --surface:#ede9e1; --fg:#30313b; --accent:#4b5fa0; --secondary:#a9a49e; --muted:#69665f; --line:#d5d0c6; }
  :root[data-palette="persimmon"] { --bg:#191a1b; --surface:#252729; --fg:#e8e5de; --accent:#f05b42; --secondary:#afa69b; --muted:#abaea9; --line:#424541; }
  :root[data-palette="purple"] { --bg:#19181e; --surface:#27242f; --fg:#e9e5ed; --accent:#b18aff; --secondary:#a6afa9; --muted:#ada7b6; --line:#443e50; }
  :root[data-mode="light"][data-palette="persimmon"] { --bg:#f4f2eb; --surface:#eae6da; --fg:#292b2c; --accent:#b73724; --secondary:#756354; --muted:#676b65; --line:#cccbbf; }
  :root[data-mode="light"][data-palette="purple"] { --bg:#f3f0f6; --surface:#e8e1ef; --fg:#2b2632; --accent:#600fed; --secondary:#526b5b; --muted:#6b6275; --line:#cfc5d9; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg); font: 18px/1.7 var(--font-text); }
  .page { width:min(100% - 3rem, 720px); margin:0 auto; min-height:100svh; display:flex; flex-direction:column; }
  main { flex:1; padding-bottom:64px; }
  .page-wide { width:min(100% - 3rem, 960px); }
  .page-wide main > article { max-width:none; }
  a { color:inherit; text-underline-offset:.23em; text-decoration-thickness:1px; }
  a:hover { color:var(--accent); }
  :focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  .skip { position:absolute; left:1rem; top:-5rem; background:var(--bg); padding:.5rem; z-index:10; }
  .skip:focus { top:1rem; }
  .masthead { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:40px 0 28px; border-bottom:1px solid var(--line); }
  body:has(.page-home) { isolation:isolate; }
  .page-home { width:min(100% - 3rem, 1320px); }
  .page-home .masthead { padding:32px 0; border-bottom:1px solid var(--line); }
  .page-home .wordmark { font-size:clamp(36px,6vw,54px); letter-spacing:-.035em; }
  .wordmark { font-size:clamp(32px, 6vw, 44px); line-height:1.2; font-weight:600; text-decoration:none; }
  h1,h2,h3 { font-size:20px; font-weight:600; line-height:1.5; letter-spacing:normal; }
  .section-label { font:inherit; color:var(--muted); }
  p { margin:0 0 1.2rem; }
  .muted { color:var(--muted); }
  footer { padding:25px 0 38px; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:12px 24px; align-items:baseline; justify-content:space-between; font-size:16px; }
  footer p { font-size:16px; line-height:1.7; }
  main > article { max-width:680px; margin:50px auto; }
  pre { padding:1rem; background:var(--surface); overflow-x:auto; }
  img,svg { max-width:100%; }
  ul.list { padding:0; list-style:none; }
  ul.list time { color:var(--muted); margin-right:1rem; }
  @media(max-width:600px) { .masthead { padding-top:36px; } footer { flex-direction:column; } }
</style>
