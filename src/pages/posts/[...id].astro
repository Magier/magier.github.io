---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostContents from '../../components/PostContents.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { topicLabel } from '../../lib/topics';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const series = post.data.series ? await getEntry(post.data.series) : undefined;
---
<Base wide title={post.data.title} description={post.data.description}>
  <div class:list={['post-layout', { 'has-contents': contents.length > 0 }]}>
    {contents.length > 0 && (
      <aside class="post-contents">
        <div class="desktop-contents">
          <p class="contents-label">On this page</p>
          <PostContents headings={contents} />
        </div>
        <details class="mobile-contents">
          <summary>On this page</summary>
          <PostContents headings={contents} />
        </details>
      </aside>
    )}
  <article>
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="post-subtitle muted">{post.data.description}</p>}
    <p class="muted">
      <time>{formatDate(post.data.date)}</time>
      {series && <> part of <a href={`/series/${series.id}/`}>{series.data.title}</a></>}
    </p>
    {post.data.tags.length > 0 && (
      <nav class="post-topics" aria-label="Post topics">
        <ul>
          {post.data.tags.map((tag) => (
            <li>
              {tag.split('/').map((_, index, segments) => {
                const path = segments.slice(0, index + 1).join('/');
                return <>{index > 0 && ' / '}<a href={`/topics/${path}/`}>{topicLabel(path)}</a></>;
              })}
            </li>
          ))}
        </ul>
      </nav>
    )}
    <Content />
  </article>
  </div>
</Base>

<style>
  .post-layout { margin:50px 0; }
  article { min-width:0; }
  .post-contents { font-size:14px; line-height:1.45; }
  .desktop-contents { display:none; }
  .mobile-contents { border-block:1px solid var(--line); margin-bottom:2rem; padding:.8rem 0; }
  .mobile-contents summary { cursor:pointer; color:var(--muted); }
  .mobile-contents[open] summary { margin-bottom:.65rem; }
  article :global(h2[id]), article :global(h3[id]) { scroll-margin-top:2rem; }
  @media (min-width:1280px) {
    .has-contents {
      width:min(calc(100vw - 3rem), 1198px);
      margin-inline:calc((100% - min(100vw - 3rem, 1198px)) / 2);
      display:grid;
      grid-template-columns:190px minmax(0, 960px);
      gap:48px;
      align-items:start;
    }
    .post-contents { position:sticky; top:2rem; max-height:calc(100dvh - 4rem); overflow-y:auto; padding:.25rem .5rem .5rem; }
    .desktop-contents { display:block; }
    .contents-label { color:var(--fg); font-weight:600; margin:0 0 .6rem; }
    .mobile-contents { display:none; }
  }
  .post-topics { margin-bottom:1.5rem; font-size:16px; color:var(--muted); }
  .post-topics ul { list-style:none; padding:0; margin:0; }
</style>
