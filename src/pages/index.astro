---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HomeLandscape from '../components/HomeLandscape.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { getTopics } from '../lib/topics';
const posts = await getPosts();
const [latest, ...older] = posts;
const series = await getCollection('series');
const topics = getTopics(posts);
---
<Base wide home>
  <HomeLandscape />

  <div class="notebook-body">
    <div class="writing">
  <section class="opening" aria-label="About this notebook">
    <p class="intro">Security, AI, and how we think about systems.<br class="desktop-break" /> Sometimes the most useful ideas are older than the problems.</p>
    <p class="aside-note">Notes, questions, and the occasional deep dive into whatever catches my attention.</p>
  </section>
      <section aria-labelledby="writing-title">
        <div class="section-heading"><h1 id="writing-title">From the notebook</h1><span>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span></div>
        {latest ? <PostCard post={latest} featured /> : <p class="muted">First notes coming soon.</p>}
        {older.length > 0 && <div class="post-grid">{older.map(post => <PostCard post={post} />)}</div>}
      </section>
      {series.length > 0 && <section class="series"><h2>Series</h2><ul>{series.map(s => <li><a href={`/series/${s.id}/`}>{s.data.title}</a><p>{s.data.description}</p></li>)}</ul></section>}
      <aside class="project" aria-labelledby="project-title">
        <p class="margin-note">Elsewhere on my desk</p>
        <h2 id="project-title"><a href="https://github.com/Magier/Ran">Ran <span aria-hidden="true">↗</span></a></h2>
        <p>My open-source project for adversary emulation in Kubernetes. Exploring a system by asking what an attacker could do with it.</p>
      </aside>
    </div>

    <aside class="sidebar">
      <div class="sidebar-sticky">
        <section class="about" aria-labelledby="about-title">
          <h2 id="about-title">Markus / Magier</h2>
          <p>I’m Markus Gierlinger. I currently research agentic AI security, with a background in Kubernetes security, symbolic AI, and software engineering.</p>
          <p>Here I follow my curiosity a little further: systems thinking, cybernetics, cognition, human biases, and older ideas worth another look.</p>
          <nav class="profile-links" aria-label="Find Markus elsewhere"><a href="https://github.com/Magier">GitHub ↗</a><a href="https://www.linkedin.com/in/markus-gierlinger/">LinkedIn ↗</a></nav>
        </section>
        {topics.length > 0 && <nav class="topics" aria-labelledby="topics-title">
          <h2 id="topics-title">Follow a thread</h2>
          <ul>{topics.map(topic => <li style={`--depth:${topic.depth}`}><a href={`/topics/${topic.path}/`}>{topic.label}<span class="topic-count">{topic.count}</span></a></li>)}</ul>
          <p>Each topic includes the branches beneath it.</p>
        </nav>}
      </div>
    </aside>
  </div>
</Base>
<style>
  .opening { padding:0 0 36px; }
  .intro { font-size:clamp(22px,3.1vw,29px); line-height:1.5; max-width:820px; margin-bottom:16px; }
  .aside-note { color:var(--muted); max-width:630px; font-size:17px; margin:0; }
  .notebook-body { display:grid; grid-template-columns:minmax(0,1fr) 250px; gap:48px; padding-top:26px; position:relative; }
  .section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin-bottom:24px; }
  h1,h2 { margin:0; font-size:19px; font-weight:500; }
  .section-heading span { color:var(--muted); font-size:14px; }
  .post-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:24px; }
  .sidebar-sticky { position:sticky; top:32px; }
  .about h2 { color:var(--fg); font-size:18px; margin-bottom:18px; }
  .about p { font-size:15px; line-height:1.75; color:var(--muted); }
  .profile-links { display:flex; flex-wrap:wrap; gap:20px; font-size:14px; }
  .topics { margin-top:30px; padding-top:24px; border-top:1px solid var(--line); }
  .topics h2 { color:var(--muted); font-size:16px; }
  .topics ul { list-style:none; margin:18px 0 14px; padding:0; }
  .topics li { padding-left:calc(var(--depth) * 14px); margin:7px 0; font-size:15px; }
  .topics a { display:flex; justify-content:space-between; gap:12px; text-decoration:none; }
  .topic-count { color:var(--muted); font-size:13px; }
  .topics p { font-size:13px; line-height:1.6; color:var(--muted); }
  .project { padding:26px 0; margin-top:36px; border-top:1px solid var(--line); }
  .margin-note { color:var(--muted); font-size:14px; font-style:italic; margin-bottom:12px; }
  .project h2 { margin-bottom:8px; }.project h2 a { text-decoration:none; color:var(--accent); }
  .project > p:last-child { max-width:610px; font-size:17px; margin:0; }
  .series { margin-top:36px; }
  @media(max-width:1100px) { .post-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:800px) { .notebook-body { grid-template-columns:1fr; gap:28px; } .sidebar { border-top:1px solid var(--line); padding-top:28px; } .sidebar-sticky { position:static; display:grid; grid-template-columns:1fr 1fr; gap:32px; } .topics { border-top:0; margin-top:0; padding-top:0; } .desktop-break { display:none; } }
  @media(max-width:540px) { .post-grid,.sidebar-sticky { grid-template-columns:1fr; } .opening { padding-bottom:30px; } }
</style>
