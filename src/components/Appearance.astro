<button class="mode-toggle" type="button" data-mode-toggle aria-label="Switch to light mode" title="Switch to light mode">
  <svg class="sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg class="moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
</button>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  function updateLabel() {
    const label = document.documentElement.dataset.mode === 'light' ? 'Switch to dark mode' : 'Switch to light mode';
    toggle?.setAttribute('aria-label', label);
    toggle?.setAttribute('title', label);
  }
  toggle?.addEventListener('click', () => {
    const mode = document.documentElement.dataset.mode === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.mode = mode;
    try { localStorage.setItem('mode', mode); } catch {}
    updateLabel();
  });
  updateLabel();
</script>
<style>
  .mode-toggle { display:grid; place-items:center; flex-shrink:0; width:44px; height:44px; border:1px solid var(--line); border-radius:50%; background:var(--bg); color:var(--fg); cursor:pointer; }
  .mode-toggle:hover { color:var(--accent); border-color:var(--accent); }
  .moon { display:none; }
  :global(html[data-mode="light"]) .sun { display:none; }
  :global(html[data-mode="light"]) .moon { display:block; }
</style>
